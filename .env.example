# Copy to .env and fill in the required values.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
DEEPSEEK_API_KEY=
RECORDHUB_ARCHIVE_PARENT_FOLDER_TOKEN=

FEISHU_BASE_URL=https://open.feishu.cn/open-apis
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
RECORDHUB_HTTP_TIMEOUT_SECONDS=30
RECORDHUB_STATE_DIR=data/state
RECORDHUB_TABLE_CONFIG=config/tables.toml
RECORDHUB_SCHEDULE_CONFIG=config/schedules.toml
RECORDHUB_MESSAGE_OVERRIDE_OPEN_ID=
RECORDHUB_CONFIRMATION_WEBHOOK_TOKEN=
RECORDHUB_ADMIN_TOKEN=
RECORDHUB_ADMIN_OPEN_ID=
RECORDHUB_LLM_CONCURRENCY=3
RECORDHUB_LLM_MAX_ATTEMPTS=3
RECORDHUB_SNAPSHOT_RETENTION_DAYS=2
RECORDHUB_SCHEDULER_ENABLED=true
RECORDHUB_EVENT_STREAM_ENABLED=true
RECORDHUB_AUTO_ADVANCE_AT=12:00

# S04-S09 periodic analysis (explicit opt-in)
RECORDHUB_ANALYSIS_ENABLED=false
RECORDHUB_SKILL_CONFIG=config/skill_versions.json
RECORDHUB_TEAM_SKILL_DEPARTMENT_ID=TEAM_MANAGEMENT
