# Copy to .env and fill in the required values.
# 飞书自建应用的 App ID。
FEISHU_APP_ID=
# 飞书自建应用的密钥，不要提交到 Git。
FEISHU_APP_SECRET=
# 工作日志多维表格的 App Token；各数据表 ID 在 config/tables.toml。
FEISHU_BITABLE_APP_TOKEN=
# DeepSeek API 密钥，不要提交到 Git。
DEEPSEEK_API_KEY=
# 日报和周期报告云文档的归档父文件夹 Token。
RECORDHUB_ARCHIVE_PARENT_FOLDER_TOKEN=

# 飞书开放平台 API 地址，通常保持默认。
FEISHU_BASE_URL=https://open.feishu.cn/open-apis
# DeepSeek API 地址，通常保持默认。
DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI 评价和分析所用的 DeepSeek 模型名称。
DEEPSEEK_MODEL=deepseek-chat
# 调用飞书和 DeepSeek 接口的单次超时秒数。
RECORDHUB_HTTP_TIMEOUT_SECONDS=30
# 本地工作流快照和运行状态目录。
RECORDHUB_STATE_DIR=data/state
# 数据表 ID 与字段映射配置文件路径。
RECORDHUB_TABLE_CONFIG=config/tables.toml
# 任务日程和人工评价截止时间配置文件路径。
RECORDHUB_SCHEDULE_CONFIG=config/schedules.toml
# 模拟模式下统一接收通知的飞书 OpenID；正式模式不生效。
RECORDHUB_MESSAGE_OVERRIDE_OPEN_ID=
# 是否启用模拟模式；启用时必须设置通知接收人 OpenID。
RECORDHUB_SIMULATION_MODE=false
# Workflow1 确认 Webhook 的 Bearer Token；留空时该接口不可用。
RECORDHUB_CONFIRMATION_WEBHOOK_TOKEN=
# 管理员 HTTP 接口的 Bearer Token；留空时这些接口不可用。
RECORDHUB_ADMIN_TOKEN=
# 对话入口（WorkBuddy）的 Bearer Token；留空时提交接口不可用。只用于提交日志，不能访问 /admin。
RECORDHUB_WORKBUDDY_TOKEN=
# 接收 Workflow1 异常通知的管理员 OpenID。
RECORDHUB_ADMIN_OPEN_ID=
# 同时处理日志 AI 评价的最大任务数。
RECORDHUB_LLM_CONCURRENCY=3
# 单次 AI 任务失败后的最多尝试次数。
RECORDHUB_LLM_MAX_ATTEMPTS=3
# 已完成日报快照保留的天数。
RECORDHUB_SNAPSHOT_RETENTION_DAYS=3
# 运行日志目录（相对进程当前目录；服务器部署建议写绝对路径）。
RECORDHUB_LOG_DIR=logs
# 日志保留天数：当天文件 + 往前 N-1 个按天轮转备份，每天 0 点轮转。
RECORDHUB_LOG_RETENTION_DAYS=3
# 日志级别 DEBUG/INFO/WARNING/ERROR/CRITICAL；DEBUG 会同时打开调度器等第三方库的详细输出。
RECORDHUB_LOG_LEVEL=INFO
# 是否启用后台定时调度。
RECORDHUB_SCHEDULER_ENABLED=true
# 是否开启飞书长连接来接收表记录变更事件。
RECORDHUB_EVENT_STREAM_ENABLED=true

# Workflow2 periodic analysis (explicit opt-in)
# 是否启用阶段、月度与周度分析流程。
RECORDHUB_WORKFLOW2_ENABLED=false
