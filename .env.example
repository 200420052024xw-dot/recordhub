# Copy to .env and fill in the required values.
# 宝塔部署：工作目录 /www/wwwroot/recordhub；监听 127.0.0.1:8100。
# 端口由 main.py serve --port 指定，不通过 .env 设置。
# 域名与 HTTPS 在宝塔配置；应用可先做本机预检。
# 迁移保留原有接口 Token；不要覆盖正在使用的 .env。
# 飞书自建应用的 App ID。
FEISHU_APP_ID=
# 飞书自建应用的密钥，不要提交到 Git。
FEISHU_APP_SECRET=
# 工作日志多维表格的 App Token；各数据表 ID 在 config/tables.toml。
FEISHU_BITABLE_APP_TOKEN=
# DeepSeek API 密钥，不要提交到 Git。
DEEPSEEK_API_KEY=
# 日报和周期报告云文档的归档父文件夹 Token。
RECORDHUB_ARCHIVE_PARENT_FOLDER_TOKEN=

# 飞书开放平台 API 地址，通常保持默认。
FEISHU_BASE_URL=https://open.feishu.cn/open-apis
# DeepSeek API 地址，通常保持默认。
DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI 评价和分析所用的 DeepSeek 模型名称。
DEEPSEEK_MODEL=deepseek-chat
# 调用飞书和 DeepSeek 接口的单次超时秒数。
RECORDHUB_HTTP_TIMEOUT_SECONDS=30
# 本地工作流快照和运行状态目录。
RECORDHUB_STATE_DIR=data/state
# 数据表 ID 与字段映射配置文件路径。
RECORDHUB_TABLE_CONFIG=config/tables.toml
# 任务日程和人工评价截止时间配置文件路径。
RECORDHUB_SCHEDULE_CONFIG=config/schedules.toml
# 模拟模式下统一接收通知的飞书 OpenID；正式模式不生效。
RECORDHUB_MESSAGE_OVERRIDE_OPEN_ID=
# 是否启用模拟模式；启用时必须设置通知接收人 OpenID。
RECORDHUB_SIMULATION_MODE=false
# 下列五项 HTTP Token 当前采用同一个值；调用方使用对应的共用值。
# 共用值可访问全部已启用接口，包括 /admin。
# Workflow1 确认 Webhook 的 Bearer Token；留空时该接口不可用。
RECORDHUB_CONFIRMATION_WEBHOOK_TOKEN=
# 管理员 HTTP 接口的 Bearer Token；留空时这些接口不可用。
RECORDHUB_ADMIN_TOKEN=
# 对话入口（WorkBuddy）的 Bearer Token；留空时提交接口不可用。
RECORDHUB_WORKBUDDY_TOKEN=
# 日志查询（WorkBuddy 查询口径）的 Bearer Token；留空时查询接口不可用。
RECORDHUB_QUERY_TOKEN=
# 批改（WorkBuddy 批改口径）的 Bearer Token；留空时批改接口不可用。
RECORDHUB_REVIEW_TOKEN=
# 接收 Workflow1 异常通知的管理员 OpenID。
RECORDHUB_ADMIN_OPEN_ID=
# 同时处理日志 AI 评价的最大任务数。
RECORDHUB_LLM_CONCURRENCY=3
# 兼容旧配置；业务 AI 由调度器统一安排延迟重试。
RECORDHUB_LLM_MAX_ATTEMPTS=3
# 已完成快照保留天数；缺少的周期材料从飞书原表重建。
RECORDHUB_SNAPSHOT_RETENTION_DAYS=2
# 未完成日期超过多少天发管理员告警（每天 3:30 巡检）。必须为正整数。
RECORDHUB_STALE_INCOMPLETE_ALERT_DAYS=3
# 未完成日期超过多少天直接删除状态文件（含飞书记录映射，删除时会告警）。必须为正整数。
RECORDHUB_STALE_INCOMPLETE_PURGE_DAYS=7
# 运行日志目录（相对进程当前目录；服务器部署建议写绝对路径）。
RECORDHUB_LOG_DIR=logs
# 日志、异常堆栈及事故资料保留天数；启动及每小时删除超过期限的记录。
RECORDHUB_LOG_RETENTION_DAYS=3
# 单个日志文件 20 MiB，整个运行日志目录默认上限 1 GiB。
RECORDHUB_LOG_MAX_BYTES=20971520
RECORDHUB_LOG_DIRECTORY_MAX_BYTES=1073741824
# 告警沿用 DeepSeek，分析失败或超时直接发送脱敏报错原文。
RECORDHUB_ALERT_AI_ENABLED=true
RECORDHUB_ALERT_ANALYSIS_TIMEOUT_SECONDS=15
# 持续故障每 6 小时最多汇总一次。
RECORDHUB_ALERT_SUMMARY_MINUTES=360
# 发布时填 Git commit 或发布编号，用于定位故障对应代码。
RECORDHUB_RELEASE=unknown
# 日志级别 DEBUG/INFO/WARNING/ERROR/CRITICAL；DEBUG 会同时打开调度器等第三方库的详细输出。
RECORDHUB_LOG_LEVEL=INFO
# 是否启用后台定时调度。
RECORDHUB_SCHEDULER_ENABLED=true
# 是否开启飞书长连接来接收表记录变更事件。
RECORDHUB_EVENT_STREAM_ENABLED=true

# Workflow2 periodic analysis (explicit opt-in)
# 是否启用阶段、月度与周度分析流程。
RECORDHUB_WORKFLOW2_ENABLED=false
