# Feishu custom application
FEISHU_APP_ID=cli_your_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_BITABLE_APP_TOKEN=your_bitable_app_token

# DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=sk-your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Runtime
RECORDHUB_HTTP_TIMEOUT_SECONDS=30
RECORDHUB_STATE_DIR=data/state
RECORDHUB_TABLE_CONFIG=config/feishu_tables.toml
RECORDHUB_MESSAGE_OVERRIDE_OPEN_ID=
RECORDHUB_SCHEDULE_CONFIG=config/schedules.toml
RECORDHUB_CONFIRMATION_WEBHOOK_TOKEN=replace_with_a_random_webhook_token
RECORDHUB_ADMIN_TOKEN=replace_with_a_random_admin_token
RECORDHUB_ADMIN_OPEN_ID=ou_your_admin_open_id
RECORDHUB_LLM_CONCURRENCY=3
RECORDHUB_LLM_MAX_ATTEMPTS=3
RECORDHUB_EXTERNAL_MAX_ATTEMPTS=3
RECORDHUB_SNAPSHOT_RETENTION_DAYS=2
RECORDHUB_SCHEDULER_ENABLED=true
# Feishu long-connection event subscription (record confirmations). Set to
# false to fall back to the automation webhook /webhooks/feishu/confirmations.
RECORDHUB_EVENT_STREAM_ENABLED=true
# Daily deadline for unconfirmed records: they auto-advance with published
# content at HH:MM local time. Empty value disables the auto-advance job.
RECORDHUB_AUTO_ADVANCE_AT=12:00
RECORDHUB_ARCHIVE_PARENT_FOLDER_TOKEN=your_folder_token
